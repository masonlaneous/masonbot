{
  "name": "masonbot",
  "version": "1.0.0",
  "description": "",
  "main": "src/index.ts",
  "type": "module",
  "scripts": {
    "dev": "pm2 stop masonbot && tsx watch src/index.ts",
    "build": "pnpm tsc --project tsconfig.json",
    "pm2": "pm2 start ecosystem.config.json --env production --only masonbot",
    "deploycommands": "pnpm run build && node deploy-commands.mjs",
    "start": "pnpm run deploycommands && pnpm run pm2",
    "update": "pnpm run deploycommands && pnpm run pm2"
  },
  "keywords": [],
  "author": "",
  "license": "ISC",
  "dependencies": {
    "axios": "^1.20.0",
    "canvas": "^3.2.3",
    "discord.js": "^14.27.0",
    "express": "^5.2.1",
    "fuse.js": "^7.5.0",
    "node-cron": "^4.6.0",
    "openai": "^4.104.0",
    "sqlite3": "^5.1.7"
  },
  "devDependencies": {
    "@types/express": "^5.0.6",
    "@types/node": "^20.19.43",
    "tsx": "^4.23.13",
    "typescript": "^5.9.3"
  },
  "pnpm": {
    "overrides": {
      "@types/node": "20"
    },
    "onlyBuiltDependencies": [
      "canvas",
      "esbuild"
    ]
  }
}